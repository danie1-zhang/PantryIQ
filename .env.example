ENVIRONMENT=development
POSTGRES_DB=pantryiq
POSTGRES_USER=pantryiq
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_PORT=5433

# Docker-internal URL. Use localhost and POSTGRES_PORT when running FastAPI outside Docker.
DATABASE_URL=postgresql+psycopg://pantryiq:replace_with_a_local_database_password@postgres:5432/pantryiq
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=/api/v1

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1

# The seed is idempotent. Leave disabled after running it once unless catalog updates are desired.
SEED_FOODS_ON_START=false
